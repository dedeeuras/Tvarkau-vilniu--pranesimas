name: Surinkti APK

# Paleidžiama po kiekvieno pakeitimo, taip pat rankiniu būdu (Actions → Run workflow)
on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Parsisiųsti kodą
        uses: actions/checkout@v4

      - name: Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Android SDK
        uses: android-actions/setup-android@v3

      - name: Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Surinkti debug APK
        env:
          # Nustatoma: Settings → Secrets and variables → Actions → New repository secret
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          TM_USERNAME: ${{ secrets.TM_USERNAME }}
          TM_PASSWORD: ${{ secrets.TM_PASSWORD }}
        run: gradle assembleDebug --no-daemon --stacktrace

      - name: Įkelti APK kaip artefaktą
        uses: actions/upload-artifact@v4
        with:
          name: app-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 30
